// Prisma Schema for R&B Asset Lifecycle Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  RNB_ADMIN
  ROAD_OFFICER
  BRIDGE_OFFICER
  BUILDING_OFFICER
  FIELD_OFFICER
}

enum AssetType {
  ROAD
  BRIDGE
  BUILDING
}

enum Condition {
  GOOD
  MODERATE
  POOR
  CRITICAL
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenanceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventType {
  CONSTRUCTED
  REGISTERED
  INSPECTED
  CONDITION_UPDATED
  MAINTENANCE_CREATED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  REPAIRED
  STATUS_CHANGED
  RETIRED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(ROAD_OFFICER)
  department    String   @default("Roads & Buildings")
  assetCategory String   @default("ROAD") // "ALL", "ROAD", "BRIDGE", "BUILDING"
  status        String   @default("ACTIVE") // "ACTIVE", "DISABLED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@index([email])
}

model Asset {
  id                  String      @id @default(uuid())
  assetCode           String      @unique
  name                String
  assetType           AssetType
  district            String
  location            String
  latitude            Float
  longitude           Float
  constructionDate    DateTime
  currentCondition    Condition   @default(GOOD)
  criticality         Criticality @default(MEDIUM)
  responsibleDivision String
  status              AssetStatus @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  roadDetails         RoadDetails?
  bridgeDetails       BridgeDetails?
  buildingDetails     BuildingDetails?

  inspections         Inspection[]
  maintenances        Maintenance[]
  lifecycleEvents     LifecycleEvent[]
  riskAssessments     RiskAssessment[]

  @@index([assetType])
  @@index([district])
  @@index([currentCondition])
  @@index([status])
}

model RoadDetails {
  id           String   @id @default(uuid())
  assetId      String   @unique
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  roadLength   Float    // in km
  roadCategory String   // e.g. State Highway, National Highway, MDR
  surfaceType  String   // e.g. Asphalt, Bituminous, Concrete
}

model BridgeDetails {
  id            String   @id @default(uuid())
  assetId       String   @unique
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bridgeLength  Float    // in meters
  bridgeType    String   // e.g. Cable-Stayed, Concrete Girder, Arch
  numberOfLanes Int
}

model BuildingDetails {
  id             String   @id @default(uuid())
  assetId        String   @unique
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buildingType   String   // e.g. Administrative HQ, Collectorate, Hospital
  numberOfFloors Int
  builtUpArea    Float    // in sq meters
}

model Inspection {
  id                 String    @id @default(uuid())
  assetId            String
  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectionDate     DateTime  @default(now())
  inspectorName      String
  condition          Condition
  observations       String
  recommendedAction  String
  photoUrl           String?
  createdAt          DateTime  @default(now())

  @@index([assetId])
}

model Maintenance {
  id                     String             @id @default(uuid())
  assetId                String
  asset                  Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue                  String
  priority               MaintenancePriority @default(MEDIUM)
  action                 String
  assignedTo             String
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  cost                   Float              @default(0)
  status                 MaintenanceStatus  @default(PENDING)
  beforePhotoUrl         String?
  afterPhotoUrl          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([assetId])
  @@index([status])
}

model LifecycleEvent {
  id          String    @id @default(uuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType   EventType
  eventDate   DateTime  @default(now())
  description String
  performedBy String
  createdAt   DateTime  @default(now())

  @@index([assetId])
  @@index([eventDate])
}

model RiskAssessment {
  id               String    @id @default(uuid())
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  conditionScore   Float
  ageScore         Float
  criticalityScore Float
  maintenanceScore Float
  totalRiskScore   Float
  riskLevel        RiskLevel
  assessedAt       DateTime  @default(now())

  @@index([assetId])
}
